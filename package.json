{
  "name": "kan-mcp",
  "version": "0.1.7",
  "description": "MCP server for Kan.bn API - exposes 40 tools for workspace, board, list, card, label, checklist, and comment management",
  "main": "dist/index.js",
  "bin": {
    "kan-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kan",
    "productivity",
    "api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelruelas/kan-mcp"
  },
  "scripts": {
